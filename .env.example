# ===== Google Sheet (existing) =====
# CSV publish URL ของชีต "ห้อง" (File > Share > Publish to web > CSV)
#
# ⚠️ CSV นี้มี PII ผู้เช่า (ชื่อ/เบอร์/สัญญา) และใครมี URL ก็เปิดได้โดยไม่ต้อง
# login Google — ความปลอดภัยทั้งหมดขึ้นกับการเก็บ URL เป็นความลับ
#   - ใช้ชื่อ server-only ตัวนี้ (โค้ดอ่านตัวนี้ก่อน แล้ว fallback ไปชื่อเก่า)
#   - ชื่อเก่า NEXT_PUBLIC_SHEET_ROOMS_CSV_URL ยังใช้ได้ แต่เลิกใช้เถอะ —
#     คำนำหน้า NEXT_PUBLIC_ คือระเบิดเวลา: วันไหนมีคน import ใน client
#     component ค่านี้จะติดไปใน JS bundle ถึง browser ทุกเครื่อง
#   - ระยะยาว: อ่านห้องผ่าน Apps Script getRooms ได้อยู่แล้ว → พิจารณา
#     เลิก publish CSV ทิ้งไปเลย (Sheet > File > Share > Publish > Stop)
SHEET_ROOMS_CSV_URL=
# (deprecated — ใช้ SHEET_ROOMS_CSV_URL แทน)
NEXT_PUBLIC_SHEET_ROOMS_CSV_URL=

# Apps Script Web App URL (Deploy > New deployment > Web app)
SHEET_WRITE_URL=

# APPS_SCRIPT_SECRET — shared secret กันคนยิง Apps Script URL ตรงๆ (v3.18.0)
# ตั้งค่าเดียวกัน 2 ที่ — ⚠️ ลำดับสำคัญ (กัน downtime): Vercel ก่อนเสมอ
#   1. ที่นี่ก่อน (Vercel env var, server-only — ห้าม NEXT_PUBLIC) + redeploy Vercel
#   2. แล้วค่อยตั้ง Apps Script > Project Settings > Script Properties > SHARED_SECRET
# ทำสลับ (Apps Script ก่อน) = write พังทั้งหมดจนกว่า Vercel redeploy เสร็จ
# ไม่ตั้งเลย = ระบบทำงานเหมือนเดิม (backward compatible, ยังไม่บังคับ)
# rollback: ลบ Script Property SHARED_SECRET → gate ปิด กลับมาปกติทันที
# สุ่ม: openssl rand -hex 32
APPS_SCRIPT_SECRET=

# (legacy/optional) CSV ของชีต "งาน" — ปัจจุบันอ่านผ่าน Apps Script แทน
NEXT_PUBLIC_SHEET_CSV_URL=


# ===== NextAuth v5 / Google OAuth (Phase 3.6) =====

# AUTH_SECRET — random 32+ char string ใช้เซ็น JWT
# สร้าง: `openssl rand -base64 32` หรือ https://generate-secret.vercel.app/32
AUTH_SECRET=

# Google OAuth Client ID + Secret
# สร้างที่ https://console.cloud.google.com/apis/credentials
# - Application type: Web application
# - Authorized redirect URIs:
#     https://<your-domain>/api/auth/callback/google
#     http://localhost:3000/api/auth/callback/google  (สำหรับ dev)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# จำเป็นบน Vercel preview/production (Auth.js ตรวจ host header)
AUTH_TRUST_HOST=true

# (optional) บังคับ canonical URL — ตั้งก็ได้ ไม่ตั้งก็ได้ ถ้ามี AUTH_TRUST_HOST=true
# AUTH_URL=https://aptdashboard-six.vercel.app

# ALLOWED_USERS — กำหนดสิทธิ์ตาม email
# รูปแบบ: "email:role,email:role,..."
# Multi-role (v3.10): ใช้ "+" คั่น เช่น "email:sales+engineer"
#
# Roles (3 modes):
#   role = "sales"       — เซลส์: ดูผังห้อง / นัดดู / สัญญา / ย้ายเข้า-ออก
#                          ห้ามลบงาน, ห้ามแก้ข้อมูลห้อง, ไม่เห็นรายได้
#   role = "engineer"    — ช่าง: ดูห้อง / ซ่อม / ทำสะอาด / อุปกรณ์
#                          ห้ามลบงาน, ห้ามแก้ข้อมูลห้อง, ไม่เห็นรายได้
#   role = "management"  — ผู้บริหาร: เห็นทุกอย่าง + รายได้ + ลบ/แก้ได้ทุกอย่าง
#
# Multi-role examples:
#   "tadin@gmail.com:sales+engineer"  — ทำได้ทั้งฝั่งเซลส์และฝั่งช่าง
#                                        (แต่ยังไม่เห็นรายได้, ลบไม่ได้)
#   "bob@gmail.com:engineer+management" — รวมสิทธิ์ทั้งสอง (= management
#                                          ครอบ engineer อยู่แล้ว, ไม่ต่างกัน)
#
# Legacy aliases (env เก่ายังทำงานได้ — auto-map ตอน parse):
#   "admin" → management
#   "staff" → sales
#
# email ที่ไม่อยู่ในรายการนี้จะถูกปฏิเสธหลัง Google login
ALLOWED_USERS=owner@example.com:management,sales1@example.com:sales,tech1@example.com:engineer,tadindeng16@gmail.com:sales+engineer


# ===== Warmup endpoint =====
# CRON_SECRET — protects /api/cron/warmup from public abuse
#
# Vercel Hobby tier จำกัด cron เป็น "daily resolution" only — ไม่พอ
# warmup ที่ต้องการ */5 นาที (เกินคืออัปเกรด Pro)
#
# ทางเลือก trigger จาก external (ฟรีหมด):
#   1. cron-job.org — https://cron-job.org      (1 นาที free, แนะนำ)
#   2. UptimeRobot — https://uptimerobot.com    (5 นาที free)
#   3. Better Uptime — https://betterstack.com  (3 นาที free)
# ตั้ง HTTP monitor:
#   URL: https://<domain>/api/cron/warmup
#   Header: Authorization: Bearer <CRON_SECRET>
#   Method: GET
#
# สุ่ม secret:  openssl rand -hex 32  (หรือ UUID v4 ก็ได้)
# ตั้งใน Vercel: vercel env add CRON_SECRET production
CRON_SECRET=

# (optional) Base URL ของ deployment — ใช้เมื่อต้อง override deploy URL
# ปกติ /api/cron/warmup จะใช้ x-vercel-deployment-url header อัตโนมัติ
# ตั้งค่านี้เฉพาะเมื่อรัน warmup จาก local dev ชี้ไป production
NEXT_PUBLIC_BASE_URL=
